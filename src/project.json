{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "repository-genesis",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "{workspaceRoot}"
      }
    },
    "start": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{workspaceRoot}"
      }
    },
    "tsc6": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc6 --noEmit -p tsconfig.ts6.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
