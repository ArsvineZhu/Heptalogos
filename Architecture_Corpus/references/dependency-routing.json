  "toolchainPolicy": {
    "authority": "25-TypeScript与仓库工具链.md",
    "primaryCompiler": "TypeScript 7.0.x",
    "compilerApiCompatibility": "@typescript/typescript6 6.0.x only for tools that require the TypeScript programmatic API",
    "moduleModel": "ESM-first / NodeNext",
    "target": "ESNext",
    "runtimeApiLibBaseline": "ES2025 with Node 24 ambient types unless a package has a stricter explicit contract",
    "nodeTypes": "@types/node major must match shipping Node major",
    "authoritativeTypecheck": "skipLibCheck=false",
    "versionSelection": "refresh current registry/upstream evidence at Catalog freeze/upgrade; do not infer exact versions from model memory or stale documents",
