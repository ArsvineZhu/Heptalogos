{
  "schemaVersion": 4,
  "asOf": "2026-08-20",
  "authority": "Current implementation routing for Foundation generic mechanics. All Foundation provider selections in scope are frozen; deferred L3 roles are intentionally absent from mandatory routes.",
  "rule": "ADOPTED is an implementation directive. Use the selected route behind the designated Heptalogos boundary. Residual product qualification does not authorize an unapproved parallel implementation.",
  "repositoryMaterialization": {
    "packageVersionAuthority": "pnpm-workspace.yaml Catalog exact direct-version pins selected from current registry/upstream evidence",
    "catalogMode": "strict",
    "packageReferences": "workspace package.json uses catalog: references; pnpm-lock.yaml owns exact resolved closure",
    "packageIdentity": "routes[].packages is the exact npm package identity authority for each adopted route; an empty array means the route is not an npm package dependency",
    "repositoryToolingPackages": [
      "prettier"
    ],
    "boundaryEnforcement": [
      "Nx module boundaries",
      "ESLint import restrictions",
      "dependency-route governance gate"
    ],
    "newDependencyRule": "classify the role before adding a dependency; current Foundation roles may not silently acquire a second provider. The baseline contains no PRIMARY_CANDIDATE/UNRESOLVED role.",
    "foundationBuiltInCodecs": {
      "toml": "js-toml 2.x",
      "json": "Node JSON primitives + SchemaRuntime validation"
    }
  },
