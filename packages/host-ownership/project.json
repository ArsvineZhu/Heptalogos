{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "host-ownership",
  "projectType": "library",
  "sourceRoot": "packages/host-ownership/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/host-ownership"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/host-ownership --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/host-ownership src/host-ownership.integration.test.ts"
      }
    }
  }
}
