{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "management-client",
  "projectType": "library",
  "tags": ["kind:product", "area:client"],
  "sourceRoot": "packages/application/management-client/src",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run product-host:generate:openapi && node packages/application/management-client/scripts/generate.mjs"
      }
    },
    "generate:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run product-host:check:openapi && node packages/application/management-client/scripts/generate.mjs --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware --ignore-pattern packages/application/management-client/src/generated/** packages/application/management-client"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/application/management-client"
      }
    }
  }
}
