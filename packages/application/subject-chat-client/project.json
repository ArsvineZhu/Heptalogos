{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "subject-chat-client",
  "projectType": "library",
  "tags": ["kind:product", "area:client"],
  "sourceRoot": "packages/application/subject-chat-client/src",
  "targets": {
    "generate": {
      "dependsOn": ["product-host:generate:subject-chat-openapi"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/application/subject-chat-client/scripts/generate.mjs"
      }
    },
    "generate:check": {
      "dependsOn": ["product-host:check:subject-chat-openapi"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/application/subject-chat-client/scripts/generate.mjs --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware --ignore-pattern packages/application/subject-chat-client/src/generated/** packages/application/subject-chat-client"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/application/subject-chat-client"
      }
    }
  }
}
