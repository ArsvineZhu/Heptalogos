{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bootstrap-runtime",
  "projectType": "library",
  "sourceRoot": "packages/bootstrap-runtime/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/bootstrap-runtime"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime src/private-postgres-bootstrap.integration.test.ts src/host-ownership-handoff.integration.test.ts src/host-maintenance.integration.test.ts src/bootstrap-recovery.integration.test.ts"
      }
    }
  }
}
