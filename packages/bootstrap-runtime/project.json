{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bootstrap-runtime",
  "projectType": "library",
  "tags": ["kind:product", "area:bootstrap"],
  "sourceRoot": "packages/bootstrap-runtime/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/bootstrap-runtime"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime test/integration/private-postgres-bootstrap.integration.test.ts test/integration/host-ownership-handoff.integration.test.ts test/integration/host-maintenance.integration.test.ts test/integration/bootstrap-recovery.integration.test.ts test/integration/canonical-initialization.integration.test.ts test/integration/execution-foundation.integration.test.ts test/integration/runtime-kernel-managed-host.integration.test.ts test/integration/runtime-host-lifecycle.integration.test.ts test/integration/durable-work-host.integration.test.ts"
      }
    },
    "test:recovery-process": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime test/integration/bootstrap-recovery-process.integration.test.ts"
      }
    },
    "test:recovery-process:postgres": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap-runtime test/integration/bootstrap-recovery-process.postgres.integration.test.ts"
      }
    }
  }
}
