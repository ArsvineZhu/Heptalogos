{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "private-postgres",
  "projectType": "library",
  "tags": ["kind:product", "area:bootstrap"],
  "sourceRoot": "packages/private-postgres/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware packages/private-postgres"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/private-postgres --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/private-postgres test/integration/controller.integration.test.ts"
      }
    }
  }
}
