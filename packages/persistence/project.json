{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "persistence",
  "projectType": "library",
  "sourceRoot": "packages/persistence/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/persistence"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/persistence --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/persistence src/persistence.integration.test.ts"
      }
    }
  }
}
