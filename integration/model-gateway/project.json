{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "model-gateway-integration",
  "projectType": "application",
  "tags": ["kind:integration", "area:model-gateway"],
  "implicitDependencies": [
    "canonical-schema",
    "persistence",
    "execution-lineage",
    "evidence",
    "configuration",
    "secret",
    "network-access",
    "ai-runtime"
  ],
  "targets": {
    "typecheck": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p integration/model-gateway/tsconfig.json"
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root integration/model-gateway test/model-gateway.integration.test.ts"
      }
    },
    "qualification": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run product-host:build && vitest run --root integration/model-gateway"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware integration/model-gateway"
      }
    }
  }
}
