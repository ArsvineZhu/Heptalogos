{
  "minTokens": 50,
  "minLines": 5,
  "mode": "weak",
  "format": ["javascript", "typescript"],
  "exitCode": 1,
  "reporters": ["ai"],
  "noColors": true,
  "noTips": true,
  "ignore": [
    "**/test/**",
    "**/tests/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/generated/**",
    "**/scripts/generate*.mjs",
    "**/vendor/**"
  ]
}
