{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "ignorePatterns": [
    "node_modules/**",
    "**/dist/**",
    "coverage/**",
    ".nx/**",
    ".vite/**",
    ".cache/**",
    "tests/toolchain/ts6-api-lane.ts"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/schema-runtime/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "ajv",
                "message": "Ajv mechanics belong behind SchemaRuntime."
              },
              {
                "name": "typebox",
                "message": "TypeBox mechanics belong behind SchemaRuntime."
              },
              {
                "name": "@heptalogos/repo-kit",
                "message": "Repository tooling must not enter product package source."
              },
              {
                "name": "knip",
                "message": "Repository analysis tooling must not enter product package source."
              },
              {
                "name": "prettier",
                "message": "Repository formatting tooling must not enter product package source."
              }
            ],
            "patterns": [
              {
                "group": [
                  "ajv/**",
                  "typebox/**",
                  "@heptalogos/repo-kit/**",
                  "knip/**",
                  "prettier/**"
                ],
                "message": "This implementation dependency is restricted to its owning adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/schema-runtime/**",
        "packages/bootstrap-state/**",
        "packages/bootstrap-runtime/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/bootstrap-state",
                "message": "BootstrapState is limited to its owning bootstrap packages."
              }
            ],
            "patterns": [
              {
                "group": ["@heptalogos/bootstrap-state/**"],
                "message": "BootstrapState is limited to its owning bootstrap packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/private-postgres/**",
        "packages/bootstrap-runtime/**",
        "packages/host-ownership/test/integration/host-ownership.integration.test.ts",
        "packages/persistence/test/integration/persistence.integration.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/private-postgres",
                "message": "Private PostgreSQL mechanics are limited to their owner and explicit bootstrap integration boundaries."
              }
            ],
            "patterns": [
              {
                "group": ["@heptalogos/private-postgres/**"],
                "message": "Private PostgreSQL mechanics are limited to their owner and explicit bootstrap integration boundaries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/bootstrap-runtime/test/integration/canonical-initialization.integration.test.ts",
        "packages/bootstrap-runtime/test/support/canonical-postgres.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/canonical-schema",
                "message": "Canonical schema internals are consumed by the explicit integration fixtures only."
              }
            ],
            "patterns": [
              {
                "group": ["@heptalogos/canonical-schema/**"],
                "message": "Canonical schema internals are consumed by the explicit integration fixtures only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/runtime-substrate/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "cordis",
                "message": "Cordis mechanics belong behind RuntimeSubstrate."
              }
            ],
            "patterns": [
              {
                "group": ["cordis/**"],
                "message": "Cordis mechanics belong behind RuntimeSubstrate."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime-substrate/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/persistence",
                "message": "RuntimeSubstrate must not depend on PersistenceService."
              },
              {
                "name": "@heptalogos/execution-lineage",
                "message": "RuntimeSubstrate must not depend on execution-lineage."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@heptalogos/persistence/**",
                  "@heptalogos/execution-lineage/**"
                ],
                "message": "RuntimeSubstrate must not depend on data or execution-lineage mechanics."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime-kernel/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/bootstrap-state",
                "message": "RuntimeKernel must not import BootstrapState directly."
              },
              {
                "name": "@heptalogos/host-ownership",
                "message": "RuntimeKernel must not import Host ownership directly."
              },
              {
                "name": "@heptalogos/canonical-schema",
                "message": "RuntimeKernel must not import canonical-schema directly."
              },
              {
                "name": "pg",
                "message": "RuntimeKernel must not import PostgreSQL mechanics."
              },
              {
                "name": "kysely",
                "message": "RuntimeKernel must not import Kysely mechanics."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@heptalogos/bootstrap-state/**",
                  "@heptalogos/host-ownership/**",
                  "@heptalogos/canonical-schema/**",
                  "pg/**",
                  "kysely/**"
                ],
                "message": "RuntimeKernel must not import Bootstrap, ownership, schema, or database mechanics."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host-ownership/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "kysely",
                "message": "Host ownership must not materialize Kysely."
              },
              {
                "name": "dbos",
                "message": "Host ownership must not materialize DBOS."
              },
              {
                "name": "@dbos-inc/dbos-sdk",
                "message": "Host ownership must not materialize DBOS."
              },
              {
                "name": "@heptalogos/persistence",
                "message": "Host ownership must not materialize PersistenceService."
              }
            ],
            "patterns": [
              {
                "group": [
                  "kysely/**",
                  "dbos/**",
                  "@dbos-inc/dbos-sdk/**",
                  "@heptalogos/persistence/**"
                ],
                "message": "Host ownership must not import persistence mechanics."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host-ownership/src/**/*.ts"],
      "excludeFiles": [
        "packages/host-ownership/src/bootstrap-admin.ts",
        "packages/host-ownership/src/host-lease-connection.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "pg",
                "message": "Raw pg is limited to Host ownership adapters."
              }
            ],
            "patterns": [
              {
                "group": ["pg/**"],
                "message": "Raw pg is limited to Host ownership adapters."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/runtime-kernel/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@dagrejs/graphlib",
                "message": "Graphlib mechanics belong behind the Runtime Kernel graph adapter."
              }
            ],
            "patterns": [
              {
                "group": ["@dagrejs/graphlib/**"],
                "message": "Graphlib mechanics belong behind the Runtime Kernel graph adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/execution-lineage/src/observability-adapter.ts",
        "packages/execution-lineage/test/unit/execution-context-runtime.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@opentelemetry/api",
                "message": "OpenTelemetry mechanics belong behind the execution-lineage observability adapter."
              }
            ],
            "patterns": [
              {
                "group": ["@opentelemetry/api/**"],
                "message": "OpenTelemetry mechanics belong behind the execution-lineage observability adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/runtime-kernel/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/execution-lineage/runtime-kernel",
                "message": "The Runtime Kernel may use only its explicit execution-lineage adapter subpath."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/bootstrap-runtime/src/bootstrap-ownership.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@bybrave/proper-lockfile2",
                "message": "The bootstrap lock provider is limited to the bootstrap ownership adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/private-postgres/src/process-adapter.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "execa",
                "message": "Process execution mechanics are limited to the private PostgreSQL process adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/host-ownership/**",
        "packages/persistence/**",
        "packages/canonical-schema/**",
        "packages/signal/**",
        "packages/bootstrap-runtime/test/integration/host-maintenance.integration.test.ts",
        "packages/bootstrap-runtime/test/integration/bootstrap-recovery.integration.test.ts",
        "packages/bootstrap-runtime/test/integration/canonical-initialization.integration.test.ts",
        "packages/bootstrap-runtime/test/support/canonical-postgres.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "pg",
                "message": "The pg driver is limited to persistence/ownership adapters and explicit integration fixtures."
              }
            ],
            "patterns": [
              {
                "group": ["pg/**"],
                "message": "The pg driver is limited to persistence/ownership adapters and explicit integration fixtures."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/persistence/**",
        "packages/canonical-schema/**",
        "packages/signal/**",
        "packages/work-queue/**",
        "packages/execution-lineage/src/activity-repository.ts",
        "packages/evidence/src/evidence-service.ts",
        "packages/bootstrap-runtime/test/integration/execution-foundation.integration.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "kysely",
                "message": "Kysely mechanics are limited to repository/migration adapters and explicit integration fixtures."
              }
            ],
            "patterns": [
              {
                "group": ["kysely/**"],
                "message": "Kysely mechanics are limited to repository/migration adapters and explicit integration fixtures."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/execution-lineage/**",
        "packages/evidence/**",
        "packages/persistence/**",
        "packages/signal/**",
        "packages/work-queue/**",
        "packages/bootstrap-runtime/test/integration/execution-foundation.integration.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/persistence/foundation-repository",
                "message": "The persistence foundation repository is an explicit internal adapter subpath."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": [
        "packages/work-queue/**",
        "packages/bootstrap-runtime/test/integration/durable-work-host.integration.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heptalogos/work-queue/foundation-repository",
                "message": "The WorkQueue foundation repository is an explicit internal adapter subpath."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts"],
      "excludeFiles": ["packages/schema-runtime/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "ajv",
                "message": "Ajv mechanics belong behind SchemaRuntime."
              },
              {
                "name": "typebox",
                "message": "TypeBox mechanics belong behind SchemaRuntime."
              }
            ],
            "patterns": [
              {
                "group": ["ajv/**", "typebox/**"],
                "message": "Schema mechanics belong behind SchemaRuntime."
              }
            ]
          }
        ]
      }
    }
  ]
}
